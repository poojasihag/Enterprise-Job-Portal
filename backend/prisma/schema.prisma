generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  fullname String
  email    String @unique
  password String
  role     Role   @default(CANDIDATE)
}

enum Role {
  CANDIDATE
  RECRUITER
}
